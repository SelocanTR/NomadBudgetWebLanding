---
// The Google Play feature graphic's stage (1024 × 500), the store's first screenshot as one
// still. Like the videos' stages it exists only under `astro dev`;
// `node video/render.mjs --page feature` captures it.

import '@fontsource-variable/inter';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
// Arabic letters only (Inter and Poppins have none); the digits stay Latin, in those.
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import '../../../../video/store-stage.css';
import { STRINGS } from '../../../i18n';
import { heroJourney, type CoverLang } from '../../../data/journey';
import { SEARCH_COPY } from '../../../../video/search-copy';
import flags from '../../../../video/assets/search/flags.json';
import phoneUrl from '../../../../video/assets/search/phone-3d.webp?url';
import paceUrl from '../../../../video/assets/search/pace.webp?url';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { lang: 'en' } }, { params: { lang: 'tr' } }, { params: { lang: 'ar' } }] : [];
}

const lang = Astro.params.lang as CoverLang;
const c = SEARCH_COPY[lang];
const perMonth = lang === 'ar' ? '/شهر' : STRINGS[lang].hero.perMonth;
const journey = heroJourney(lang);
const flag = (code: string) => (flags as Record<string, string>)[code].replace('<svg ', '<svg preserveAspectRatio="xMidYMid slice" width="100%" height="100%" ');

// The store's three open chips — Spain on a stem above Turkey — and Georgia between, folded.
const SHOW: { code: string; open: boolean; lift?: number }[] = [
  { code: 'ES', open: true, lift: 54 }, { code: 'TR', open: true }, { code: 'GE', open: false }, { code: 'TH', open: true },
];
const chips = SHOW.map((s) => { const st = journey.stops.find((x) => x.code === s.code)!; return { ...s, name: st.name, amount: st.amount, lonLat: st.lonLat }; });
const route = [{ from: 'ES', to: 'TR', transport: 'flight' }, { from: 'TR', to: 'GE', transport: 'car' }, { from: 'GE', to: 'TH', transport: 'flight' }];
const data = { chips, route, journeyCodes: journey.stops.map((s) => s.code) };
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Nomad Budget feature graphic</title>
  </head>
  <body>
    <div class="stage" data-video>
      <canvas class="v-stars"></canvas>

      <div class="v-phone">
        <img class="phone-body" src={phoneUrl} alt="" />
        <div class="phone-screen">
          <img src={paceUrl} alt="" />
          <span class="island"></span>
        </div>
      </div>

      <canvas class="v-globe"></canvas>
      <canvas class="v-routes"></canvas>

      <div class="v-pins">
        {chips.map((ch) => (
          <div class="chip">
            <div class="chip-body">
              <span class="chip-flag" set:html={flag(ch.code)} />
              <span class="chip-text">
                <span class="chip-name">{ch.name}</span>
                <span class="chip-amount">{ch.amount}{perMonth}</span>
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="v-pills">
        {c.audiences.map((a) => <p class="pill glass-dark">{a}<img src="/icons/globe-48.webp" alt="" /></p>)}
      </div>

      <h1 class="head">{c.hook[0]} <span class="glow">{c.hook[1]}</span></h1>
    </div>

    <script type="application/json" id="feature-data" set:html={JSON.stringify(data)} />
    <script>
      import { startFeature } from '../../../../video/feature';
      startFeature(document.querySelector<HTMLElement>('[data-video]')!);
    </script>
  </body>
</html>

<style is:global>
  /* The videos' near-black space, as every other store picture has it (asked 2026-10-21; the
     navy it had stood out against them). */
  .stage { position: relative; width: 1024px; height: 500px; overflow: hidden; color: #fff; background: #040812; }
  .stage > * { position: absolute; }
  .v-stars { inset: 0; width: 100%; height: 100%; }
  .v-globe, .v-routes { inset: 0; width: 100%; height: 100%; }
  .v-pins { inset: 0; z-index: 0; }
  /* A size down from the videos': this frame is shown about as wide as the videos are. */
  .chip-flag { width: 44px; height: 44px; }
  .chip-name { font-size: 22px; }
  .chip-amount { font-size: 19px; }
  .v-pills { flex-direction: column; align-items: flex-start; gap: 8px; }
  /* On glass, as the search video's (store-stage.css's are white). */
  .pill.glass-dark { color: #fff; }
  .pill { font-size: 18px; padding-block: 5px; padding-inline: 14px 6px; gap: 8px; }
  .pill img { width: 26px; height: 26px; }

  /* Arabic: Cairo after the Latin faces, untracked; the headline and the pills flush right
     in one narrower column, so they share its edge and stay off the planet. */
  html[lang='ar'] body { font-family: 'Inter Variable', 'Cairo', system-ui, sans-serif; }
  html[lang='ar'] .head, html[lang='ar'] .pill { font-family: 'Poppins', 'Cairo', sans-serif; letter-spacing: 0; }
  html[lang='ar'] .head { line-height: 1.3; }
  html[lang='ar'] .chip-name { letter-spacing: 0; }
  html[lang='ar'] .head { width: 330px !important; font-size: 38px !important; }
  html[lang='ar'] .v-pills { width: 330px; }
</style>
