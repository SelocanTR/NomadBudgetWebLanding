---
// The App Store search video's stage (3:2): the store's first screenshots in motion — the
// headline, the 3D phone with the app's own screens on it, the globe in front of it with
// its chips — over three of the store's lines, on a loop. Like the marketing video's, it
// exists only under `astro dev`, and `node video/render.mjs --page search` captures it.
//
//   /video/search/en/?t=12.5        one moment
//   /video/search/en/?play          in real time, looping

import '@fontsource-variable/inter';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
// Arabic letters only (Inter and Poppins have none); the digits stay Latin, in those.
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import '../../../../video/store-stage.css';
import { STRINGS } from '../../../i18n';
import { heroJourney, STOPS, type CoverLang } from '../../../data/journey';
import { SEARCH_COPY } from '../../../../video/search-copy';
import { USD_PER } from '../../../../video/copy';
import cost from '../../../../video/assets/cost.json';
import flags from '../../../../video/assets/search/flags.json';
import phoneUrl from '../../../../video/assets/search/phone-3d.webp?url';
import paceUrl from '../../../../video/assets/search/pace.webp?url';
import japanUrl from '../../../../video/assets/search/japan.webp?url';
import totalUrl from '../../../../video/assets/search/total.webp?url';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { lang: 'en' } }, { params: { lang: 'tr' } }, { params: { lang: 'ar' } }] : [];
}

const lang = Astro.params.lang as CoverLang;
const c = SEARCH_COPY[lang];
// Dollars in Arabic as "$6,786": Arabic's own "US$" turns round in a right-to-left line.
const LOCALE: Record<CoverLang, string> = { en: 'en-US', tr: 'tr-TR', ar: 'en-US' };
const perMonth = lang === 'ar' ? '/شهر' : STRINGS[lang].hero.perMonth;
const journey = heroJourney(lang);
const stop = (code: string) => journey.stops.find((s) => s.code === code)!;
const usd = (v: number) => new Intl.NumberFormat(LOCALE[lang], { style: 'currency', currency: 'USD', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(v);
const flag = (code: string) => (flags as Record<string, string>)[code].replace('<svg ', '<svg preserveAspectRatio="xMidYMid slice" width="100%" height="100%" ');
const anchorOf = (code: string) => (cost.anchors as unknown as Record<string, [number, number]>)[code];

// What one of the trip's monthly spends comes to in the total's currency (rough rates, as
// the marketing video's: the figures are illustrative).
const inHome = (code: string) => { const s = STOPS.find((x) => x.code === code)!; return (s.amount * USD_PER[s.currency]) / USD_PER[c.currency]; };

// Every chip the video shows, keyed by its scene and country; the director times them.
type Chip = { key: string; code: string; name: string; amount: string | null; lonLat: [number, number]; value?: number };
const j = (scene: string, code: string): Chip => { const s = stop(code); return { key: `${scene}-${code}`, code, name: s.name, amount: s.amount, lonLat: s.lonLat }; };
const wallets = ['FR', 'TR', 'GE', 'TH', 'MY'];
const chips: Chip[] = [
  ...['ES', 'TR', 'GE', 'TH', 'MY'].map((code) => j('A', code)),
  { key: 'B-KZ', code: 'KZ', name: c.japan.home, amount: null, lonLat: anchorOf('KZ') },
  { key: 'B-JP', code: 'JP', name: c.japan.name, amount: usd(c.japan.usd), lonLat: anchorOf('JP') },
  ...wallets.map((code) => ({ ...j('C', code), value: inHome(code) })),
];
const total = Math.round(wallets.reduce((s, code) => s + inHome(code), 0));
const money = (v: number) => new Intl.NumberFormat(LOCALE[lang], { style: 'currency', currency: c.currency, currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(v);

// The headlines a word at a time (spaces kept between the words, so lines still break),
// the green part on a line of its own.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const words = (s: string) => s.split(' ').map((w) => `<span class="w">${esc(w)}</span>`).join(' ');
const headlines = [c.hook, c.basket, c.wallets].map(([a, b]) => `${words(a)} <span class="glow">${words(b)}</span>`);
const data = { locale: LOCALE[lang], currency: c.currency, total, chips, journeyCodes: journey.stops.map((s) => s.code) };
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Nomad Budget search</title>
  </head>
  <body>
    <div class="stage" data-video>
      <canvas class="v-stars"></canvas>

      <div class="v-phone">
        <img class="phone-body" src={phoneUrl} alt="" />
        <div class="phone-screen">
          <img src={paceUrl} alt="" />
          <img src={japanUrl} alt="" />
          <img src={totalUrl} alt="" />
          <span class="island"></span>
        </div>
      </div>

      <canvas class="v-globe"></canvas>
      <canvas class="v-routes"></canvas>

      <div class="v-pins">
        {chips.map((ch) => (
          <div class="chip" data-key={ch.key}>
            <div class="chip-body">
              <span class="chip-flag" set:html={flag(ch.code)} />
              <span class="chip-text">
                <span class="chip-name">{ch.name}</span>
                {ch.amount && <span class="chip-amount">{ch.amount}{perMonth}</span>}
              </span>
            </div>
          </div>
        ))}
        <div class="v-badge" dir="ltr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>{c.japan.change}</div>
      </div>

      <div class="v-total glass-dark">
        <p class="total-label">{c.totalLabel}</p>
        <p class="total-amount"><span class="total-value">{money(total)}</span></p>
        <p class="total-sub">{c.totalSub}</p>
      </div>

      <div class="v-pills">
        {c.audiences.map((a) => <p class="pill glass-dark">{a}<img src="/icons/globe-48.webp" alt="" /></p>)}
      </div>

      <div class="v-heads">
        {headlines.map((html) => <h1 class="head" set:html={html} />)}
      </div>
    </div>

    <script type="application/json" id="search-data" set:html={JSON.stringify(data)} />
    <script>
      import { startSearch } from '../../../../video/search';
      startSearch(document.querySelector<HTMLElement>('[data-video]')!);
    </script>
  </body>
</html>

<style is:global>
  /* 960 × 640 at 3× is 2880 × 1920. */
  .stage { position: relative; width: 960px; height: 640px; overflow: hidden; background: #040812; color: #fff; }
  .stage > * { position: absolute; }
  /* The sky a little larger than the frame, so it can drift behind the planet. */
  .v-stars { left: -40px; top: -40px; width: calc(100% + 80px); height: calc(100% + 80px); }
  .v-globe, .v-routes { inset: 0; width: 100%; height: 100%; }
  .v-pins, .v-heads { inset: 0; }
  .v-pins { z-index: 0; }

  /* Everything comes and goes here: hidden until the director shows it. */
  .head .w { display: inline-block; opacity: 0; will-change: transform, opacity, filter; }
  .pill { opacity: 0; }
  /* The audience pills on glass, as the total card is (store-stage.css's are white). */
  .pill.glass-dark { color: #fff; }

  /* The app's change pill (the Japan sheet's "+68%": dearer than home), larger. */
  .v-badge {
    position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 4px;
    padding: 6px 14px 6px 10px; border-radius: 999px; background: #E5484D; color: #fff;
    font-size: 28px; font-weight: 800; font-variant-numeric: tabular-nums;
    box-shadow: 0 10px 26px rgba(0, 0, 0, .4); opacity: 0; transform-origin: 0 50%; z-index: 90;
  }
  .v-badge svg { width: 24px; height: 24px; }

  /* The total (the marketing video's). */
  .v-total { left: 0; top: 0; padding: 16px 24px 14px; border-radius: 24px; opacity: 0; transform-origin: 0 100%; }
  .total-label { font-size: 18px; font-weight: 600; color: #B7C2D0; }
  .total-amount { margin-top: 2px; font-size: 52px; font-weight: 800; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .total-sub { margin-top: 4px; font-size: 17px; font-weight: 600; color: #52D69B; }

  /* Arabic: Cairo after the Latin faces, untracked (spacing pulls joined letters apart), and
     taller lines for its ascenders and dots. */
  html[lang='ar'] body { font-family: 'Inter Variable', 'Cairo', system-ui, sans-serif; }
  html[lang='ar'] .head, html[lang='ar'] .pill { font-family: 'Poppins', 'Cairo', sans-serif; letter-spacing: 0; }
  html[lang='ar'] .head { line-height: 1.3; }
  html[lang='ar'] .chip-name { letter-spacing: 0; }
</style>
