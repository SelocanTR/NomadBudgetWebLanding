---
// The marketing video's stage: the hero's globe, the cost layer, the store screenshots
// and the words, all drawn from one clock. It exists only under `astro dev` — a build
// makes no page here — and video/render.mjs captures it frame by frame.
//
//   /video/en/?t=12.5            one moment
//   /video/en/?play              in real time, looping
//   /video/tr/?f=landscape       16:9 instead of 9:16

import '@fontsource-variable/inter';
// Arabic letters only (Inter and Poppins have none); the digits stay Latin, in those.
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import { heroJourney, flagSvg, STOPS, type CoverLang } from '../../data/journey';
import { COPY, USD_PER } from '../../../video/copy';
import cost from '../../../video/assets/cost.json';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { lang: 'en' } }, { params: { lang: 'tr' } }, { params: { lang: 'ar' } }] : [];
}

const lang = Astro.params.lang as CoverLang;
const c = COPY[lang];
const journey = heroJourney(lang);
// Dollars in Arabic as "$12,363": Arabic's own "US$" turns round in a right-to-left line.
const LOCALE: Record<CoverLang, string> = { en: 'en-US', tr: 'tr-TR', ar: 'en-US' };
const perMonth = { en: '/mo', tr: '/ay', ar: '/شهر' }[lang];

const totalUsd = STOPS.reduce((sum, s) => sum + s.amount * USD_PER[s.currency], 0);
const total = Math.round(totalUsd / USD_PER[c.home.currency]);
const money = (v: number) =>
  new Intl.NumberFormat(LOCALE[lang], { style: 'currency', currency: c.home.currency, currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(v);
const refFlag = ((cost as unknown as { flags: Record<string, string> }).flags)[c.reference.code].replace('<svg ', '<svg preserveAspectRatio="xMidYMid slice" width="100%" height="100%" ');
const captions = [c.currencies, c.journey, c.total, c.cost, ...c.screens.map((s) => s.caption)];
const SCALE = ['#1FA37A', '#9AEAC4', '#4F5DDD', '#F2A93B', '#E3489C'];
const data = { lang, locale: LOCALE[lang], journey, home: c.home, reference: c.reference, total, totalText: money(total), shots: c.screens.map((s) => s.shot) };
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Nomad Budget video</title>
  </head>
  <body>
    <div class="stage" data-video>
      <canvas class="v-stars"></canvas>
      <canvas class="v-globe"></canvas>
      <canvas class="v-routes"></canvas>

      <div class="v-pins">
        {journey.stops.map((stop) => (
          <div class="chip">
            <div class="chip-body">
              <span class="chip-flag" set:html={flagSvg(stop.code)} />
              <span class="chip-text">
                <span class="chip-name">{stop.name}</span>
                <span class="chip-amount">{stop.amount}{perMonth}</span>
              </span>
            </div>
          </div>
        ))}
        <div class="home-pin">
          <div class="home-ring"></div>
          <div class="chip-body home-body">
            <span class="chip-flag" set:html={refFlag} />
            <span class="chip-text"><span class="chip-name">{c.reference.label}</span></span>
          </div>
        </div>
      </div>

      <div class="v-shade"></div>
      <div class="v-scrim"></div>

      <div class="v-captions">
        <!-- The opening is the landing's hero: its eyebrow, one audience at a time, over its title. -->
        <h1 class="caption">
          <span class="eyebrow">
            <img src="/icons/globe-48.webp" alt="" />
            <span class="eyebrow-roll">{c.audiences.map((a) => <span class="eyebrow-word">{a}</span>)}</span>
          </span>
          <span class="line">{c.hook[0]}</span><span class="line glow">{c.hook[1]}</span>
        </h1>
        {captions.map(([a, b]) => (
          <h1 class="caption"><span class="line">{a}</span><span class="line glow">{b}</span></h1>
        ))}
      </div>

      <div class="v-total glass-dark">
        <p class="total-label">{c.totalLabel}</p>
        <p class="total-amount"><span class="total-value">{money(total)}</span></p>
        <p class="total-sub">{c.totalSub}</p>
      </div>

      <div class="v-legend glass-dark">
        <div class="legend-head">
          <div class="legend-side">
            <span class="legend-title">{c.legendTitle}</span>
            <span class="legend-info"><svg viewBox="0 0 24 24" fill="none" stroke="#C9D3DF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg></span>
          </div>
          <div class="legend-side">
            <span class="chip-flag legend-flag" set:html={refFlag} />
            <span class="legend-country">{c.reference.name}</span>
            <svg class="legend-chevron" viewBox="0 0 24 24" fill="none" stroke="#C9D3DF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6" /></svg>
          </div>
        </div>
        <div class="legend-bar">
          {SCALE.map((col) => <span style={`background:${col}`} />)}
        </div>
        <div class="legend-words"><span>{c.bands[0]}</span><span>{c.bands[2]}</span><span>{c.bands[4]}</span></div>
      </div>

      <div class="v-phone">
        {c.screens.map((s) => <img src={`/shots/${s.shot}.webp`} alt="" />)}
      </div>

      <div class="v-end">
        <img class="end-icon" src="/icons/icon-512.png" alt="" />
        <p class="end-name">{c.name}</p>
        <p class="end-tagline">{c.tagline}</p>
        <p class="end-for">{c.audiences.map((a) => <span class="glass-dark">{a}</span>)}</p>
        <p class="end-cta">{c.cta}</p>
        <p class="end-url">{c.url}</p>
      </div>

    </div>

    <script type="application/json" id="video-data" set:html={JSON.stringify(data)} />
    <script>
      import { startVideo } from '../../../video/director';
      startVideo(document.querySelector<HTMLElement>('[data-video]')!);
    </script>
  </body>
</html>

<style is:global>
  /* Widths include padding and borders, so a card centred by half its width is centred. */
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; background: #040812; overflow: hidden; }
  body { font-family: 'Inter Variable', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  p, h1 { margin: 0; }

  .stage { --W: 540px; --H: 960px; position: relative; width: var(--W); height: var(--H); overflow: hidden; background: #040812; color: #fff; }
  .stage.landscape { --W: 960px; --H: 540px; }
  .stage > * { position: absolute; }
  .v-stars, .v-globe, .v-routes { inset: 0; width: 100%; height: 100%; }
  .v-pins, .v-captions { inset: 0; }
  /* Its own layer, so a chip's z-index ranks it among chips and never lifts it over the words. */
  .v-pins { z-index: 0; }
  .v-shade { inset: 0; background: #040812; opacity: 0; }
  /* The words sit over the top of the planet when it is close in. */
  .v-scrim { left: 0; right: 0; top: 0; height: 360px; background: linear-gradient(180deg, rgba(4, 8, 18, .9) 0%, rgba(4, 8, 18, .6) 55%, rgba(4, 8, 18, 0) 100%); }
  .landscape .v-scrim { top: 0; bottom: 0; right: auto; width: 520px; height: auto; background: linear-gradient(90deg, rgba(4, 8, 18, .88) 0%, rgba(4, 8, 18, .55) 60%, rgba(4, 8, 18, 0) 100%); }

  /* The site's GlassCard in its dark theme, tinted a little deeper: it sits on the planet,
     whose bright deserts and ice would wash out white text behind a clearer pane. */
  .glass-dark {
    background-color: rgba(12, 19, 32, .5);
    background-image: linear-gradient(160deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .03));
    border: 1px solid rgba(255, 255, 255, .16);
    box-shadow: 0 24px 56px -18px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255, 255, 255, .1);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }

  /* --- captions ------------------------------------------------------------------------- */
  .caption {
    position: absolute; left: 24px; right: 24px; top: 124px;
    text-align: center; font-size: 42px; font-weight: 800; line-height: 1.04; letter-spacing: -0.035em;
    opacity: 0; text-wrap: balance;
  }
  .caption .line { display: block; }
  .caption .glow { color: #52D69B; }
  /* The landing's eyebrow: a pill with the globe, and the audience in it changing. */
  /* The hero's title is longer than a caption: a size down, so three lines (Turkish) still
     end above the note under it. */
  .caption:first-child { top: 64px; font-size: 38px; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 16px;
    padding: 7px 14px 7px 10px; border-radius: 999px;
    background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .14);
    font-size: 16px; font-weight: 600; letter-spacing: .01em; line-height: 1.3; color: #D6DEEA;
  }
  .eyebrow img { width: 22px; height: 22px; flex: none; }
  .eyebrow-roll { position: relative; display: block; height: 1.3em; overflow: hidden; }
  .eyebrow-word { position: absolute; left: 0; top: 0; white-space: nowrap; opacity: 0; }
  .landscape .caption { left: 60px; right: auto; width: 420px; top: 150px; text-align: left; font-size: 46px; }
  .landscape .eyebrow { margin-bottom: 18px; }
  .landscape .caption:first-child { width: 460px; font-size: 41px; }

  /* --- chips (the hero's, with the clock driving what CSS transitions did there) ---------- */
  /* The chips' colours, set by video/themes.ts as the planet changes theme. */
  .stage { --chip-fill: #fff; --chip-ink: #0E1726; --chip-muted: #6B7684; --chip-edge: transparent; }
  .chip, .home-pin { position: absolute; left: 0; top: 0; }
  .chip-body {
    position: absolute; left: 0; bottom: 11px;
    display: flex; align-items: center; gap: 0;
    padding: 4px; border-radius: 999px;
    background: var(--chip-fill); color: var(--chip-ink); outline: 1.5px solid var(--chip-edge); outline-offset: -1.5px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, .38), 0 1px 2px rgba(0, 0, 0, .2);
    white-space: nowrap; opacity: 0; transform-origin: 50% 100%;
  }
  .chip-body::after {
    content: ''; position: absolute; left: 50%; bottom: -6px; margin-left: -6px;
    border: 6px solid transparent; border-bottom: 0; border-top-color: var(--chip-fill);
  }
  .chip-flag { width: 34px; height: 34px; border-radius: 50%; overflow: hidden; flex: none; box-shadow: 0 0 0 1px rgba(14, 23, 38, .08); }
  .chip-text { display: grid; max-width: 0; opacity: 0; overflow: hidden; line-height: 1.15; }
  .chip-name { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .chip-amount { font-size: 16.5px; font-weight: 600; color: var(--chip-muted); font-variant-numeric: tabular-nums; }
  .home-body .chip-text { max-width: 120px; opacity: 1; padding-block: 0; padding-inline: 8px 10px; }
  .home-ring { position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%; background: #52D69B; box-shadow: 0 0 0 3px rgba(4, 8, 18, .55); opacity: 0; }

  /* --- the total ---------------------------------------------------------------------- */
  /* 9:16: the cards come up at the very foot of the frame, under the planet. */
  .v-total {
    left: 50%; bottom: 48px; width: 320px; margin-left: -160px; padding: 18px 20px 16px;
    border-radius: 26px; text-align: center; color: #fff;
    opacity: 0; transform-origin: 50% 100%;
  }
  .landscape .v-total { left: 60px; margin-left: 0; top: 290px; bottom: auto; text-align: left; transform-origin: 50% 0; }
  .total-label { font-size: 15px; font-weight: 600; color: #B7C2D0; }
  .total-amount { margin-top: 4px; font-size: 46px; font-weight: 800; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .total-sub { margin-top: 6px; font-size: 14px; font-weight: 600; color: #52D69B; }

  /* --- the cost legend: the app's cost card (world.tsx) — a Card, "Priced against" and its
     info button, home's flag and name, one unbroken bar, three muted words — at the size
     a phone would show it on this stage. --------------------------------------------- */
  .v-legend {
    left: 24px; right: 24px; bottom: 48px; padding: 24px 24px 20px;
    border-radius: 22px; color: #fff; opacity: 0;
  }
  .landscape .v-legend { left: 60px; right: auto; bottom: auto; width: 420px; }
  .legend-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .legend-side { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .legend-title { font-size: 17px; line-height: 23px; font-weight: 500; }
  .legend-info { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 50%; background: rgba(255, 255, 255, .1); flex: none; }
  .legend-info svg { width: 18px; height: 18px; }
  .legend-flag { width: 26px; height: 26px; }
  .legend-country { font-size: 17px; line-height: 23px; font-weight: 600; white-space: nowrap; }
  .legend-chevron { width: 16px; height: 16px; flex: none; }
  .legend-bar { display: flex; margin-top: 16px; border-radius: 10px; overflow: hidden; }
  .legend-bar span { flex: 1; height: 13px; }
  .legend-words { display: flex; justify-content: space-between; margin-top: 6px; font-size: 14px; line-height: 18px; font-weight: 500; color: #B7C2D0; }

  /* --- the phone ---------------------------------------------------------------------- */
  .v-phone {
    left: 50%; top: 250px; width: 296px; margin-left: -148px; aspect-ratio: 720 / 1558;
    border: 8px solid #0E1726; border-radius: 44px; overflow: hidden; background: #0E1726;
    box-shadow: 0 40px 90px rgba(0, 0, 0, .6), 0 0 0 1px rgba(255, 255, 255, .12);
    opacity: 0;
  }
  .landscape .v-phone { left: auto; right: 170px; margin-left: 0; top: 24px; width: 242px; }
  .v-phone img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }

  /* --- the end card ------------------------------------------------------------------- */
  .v-end { inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding-bottom: 40px; }
  .v-end > * { opacity: 0; }
  .end-name, .end-tagline, .end-url { text-shadow: 0 2px 18px rgba(4, 8, 18, .85), 0 1px 3px rgba(4, 8, 18, .6); }
  .end-icon { width: 132px; height: 132px; border-radius: 30px; box-shadow: 0 24px 60px rgba(0, 0, 0, .55); }
  .end-name { margin-top: 26px; font-size: 44px; font-weight: 800; letter-spacing: -0.035em; }
  .end-tagline { margin-top: 8px; font-size: 19px; font-weight: 600; color: #B7C2D0; }
  .end-for { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 460px; margin-top: 20px; }
  .end-for span { padding: 7px 14px; border-radius: 999px; font-size: 15px; font-weight: 600; color: #E3E9F1; white-space: nowrap; }
  .landscape .end-for { max-width: none; }
  .landscape .end-icon { width: 104px; height: 104px; border-radius: 24px; }
  .landscape .end-name { margin-top: 18px; }
  .end-cta { margin-top: 26px; padding: 16px 28px; border-radius: 999px; background: #52D69B; color: #11371C; font-size: 19px; font-weight: 800; box-shadow: 0 10px 30px rgba(82, 214, 155, .35); }
  .end-url { margin-top: 18px; font-size: 16px; font-weight: 600; color: #8B97A6; }


  /* --- Arabic: right to left. Cairo after the Latin faces, untracked (spacing pulls joined
     letters apart), taller lines for its ascenders and dots. In 16:9 the words keep their
     place left of the planet, set flush right in it. ------------------------------------- */
  html[lang='ar'] body { font-family: 'Inter Variable', 'Cairo', system-ui, sans-serif; }
  html[lang='ar'] .caption, html[lang='ar'] .chip-name, html[lang='ar'] .end-name { letter-spacing: 0; }
  html[lang='ar'] .caption { line-height: 1.3; }
  html[lang='ar'] .eyebrow { padding-inline: 10px 14px; }
  html[lang='ar'] .eyebrow-word { left: auto; right: 0; }
  html[lang='ar'] .landscape .caption, html[lang='ar'] .landscape .v-total { text-align: right; }
</style>
