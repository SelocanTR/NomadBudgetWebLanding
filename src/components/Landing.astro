---
import { STRINGS, appStoreUrl, blogPath, type Lang } from '../i18n';
import { allPosts, postsIn } from '../blog';
import Hero from './Hero.astro';
import { STRIP_TILES } from '../data/strip';
import PostCard from './PostCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = STRINGS[lang];
const store = appStoreUrl(lang);
/** The app's own profile avatars, one per kind of traveller, in `audience.items` order:
 *  the one working from a beach, the one on a terrace abroad, the explorer, the one with
 *  a city at dusk, the one holding a chart that grows — and two for the couple. */
const AVATARS = [['avatar_2'], ['avatar_7'], ['avatar_1'], ['avatar_6'], ['avatar_3'], ['avatar_4', 'avatar_8']];
/** The vehicle the trip turns into at each stop, one per feature (the hero's sprites);
 *  no two stops in a row share one, so every arrival changes it. */
/** Who it's for, as luggage tags: each tag's colour, the four accents in turn, and the
 *  slight angle it hangs at. */
const TAG_ACCENTS = ['lime', 'blue', 'magenta', 'orange'];
const TAG_TILTS = [-1.2, .8, -.5, 1, -.9, .6];
const ROUTE_VEHICLES = ['train', 'ferry', 'bus', 'flight', 'car', 'bus', 'train', 'flight'];
/** The strip's polaroids lie as if dropped on a table: each its own tilt (degrees) and
 *  lift (px), by its place on the strip, so a tile and its repeat match and the loop is seamless. */
const TILTS = [-3.5, 2, -1, 3, -2.5, 1.5, -2, 3.5, -1.5, 2.5, -3, 1, -1.5, 3, -2, 0.5, 2, -2.5];
const LIFTS = [0, 6, -4, 3, -6, 2, 5, -3, -1, 4, -5, 1, 6, -2, 3, -6, 0, 5];
const lie = (i: number) => `--tilt: ${TILTS[i % TILTS.length]}deg; --lift: ${LIFTS[i % LIFTS.length]}px`;
/** The closing call's pass: from NMD to BGT, the app's name as two airport codes; and
 *  the countries' polaroids on the table under it. */
const PASS_CODES = ['NMD', 'BGT'];
const TABLE = ['GR', 'IS', 'VN', 'HR'].map((code) => STRIP_TILES.find((t) => t.code === code)!);
/** The newest posts, once the blog has any in this language. */
const latest = postsIn(lang, await allPosts()).slice(0, 3);
---

<Hero lang={lang} />

<section class="what" aria-labelledby="what-title">
  <!-- Behind the card, the app's country pictures as polaroids on one strip running through
       its middle: the journey the globe just drew, then more places to go. The strip is its
       tiles twice over, so sliding it by half comes back to where it began. -->
  <div class="strip" aria-hidden="true">
    <div class="strip-track">
      {[...STRIP_TILES, ...STRIP_TILES].map((c, i) => (
        <figure class="strip-tile" style={lie(i % STRIP_TILES.length)}>
          <img src={c.src} width="480" height="360" alt="" loading="lazy" decoding="async" />
          <figcaption>
            <span class="strip-flag" set:html={c.flag} />
            <span class="strip-name">{c.name[lang]}</span>
            <span class="strip-currency">{c.currency}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="container">
    <div class="box">
      <img class="what-coin" src="/icons/coin-96.webp" width="56" height="56" alt="" loading="lazy" />
      <h2 id="what-title">{s.what.title}</h2>
      <div class="rule" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <p>{s.what.body}</p>
    </div>
  </div>
</section>

<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head center">
      <p class="kicker">{s.features.eyebrow}</p>
      <h2 id="features-title">{s.features.title}</h2>
    </div>
    <div class="features">
      <!-- The trip down the gap between the columns: a stop at every feature, a vehicle
           that scrolls from one to the next (the script at the foot of the page). -->
      <div class="route" aria-hidden="true" data-vehicles={ROUTE_VEHICLES.join(' ')}>
        <div class="route-fill"></div>
        <div class="route-vehicle">
          {ROUTE_VEHICLES.filter((v, i, all) => all.indexOf(v) === i).map((v) => (
            <img src={`/transport/${v}.webp`} data-vehicle={v} width="256" height="256" alt="" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
      {s.features.items.map((f, i) => (
        <article class={`feature c-${f.accent}`} id={f.key} data-accent={f.accent}>
          <span class="route-stop" aria-hidden="true"></span>
          <div class="feature-media">
            <img src={`/shots/${f.shot}.webp`} width="720" height="1558" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="feature-copy">
            <p class="feature-index">{String(i + 1).padStart(2, '0')}</p>
            <h3>{f.title[0]} <span>{f.title[1]}</span></h3>
            <p>{f.body}</p>
            <ul class="checks">
              {f.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- The app's home-screen wash behind the next three sections, glass cards on it. -->
<div class="wash">
  <section class="section" aria-labelledby="more-title">
    <div class="container">
      <div class="section-head center"><h2 id="more-title">{s.more.title}</h2></div>
      <div class="cards">
        {s.more.items.map((c) => (
          <article class="card glass">
            <img src={`/art/tile-${c.art}.webp`} width="88" height="88" alt="" loading="lazy" decoding="async" />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head center"><h2 id="steps-title">{s.steps.title}</h2></div>
      <ol class="steps">
        {s.steps.items.map((step) => (
          <li class="step">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tight" aria-labelledby="people-title">
    <div class="container">
      <div class="section-head center">
        <h2 id="people-title">{s.audience.title}</h2>
        <p>{s.audience.body}</p>
      </div>
      <div class="people">
        {s.audience.items.map((p, i) => (
          <article class={`person c-${TAG_ACCENTS[i % TAG_ACCENTS.length]}`} style={`--tilt: ${TAG_TILTS[i % TAG_TILTS.length]}deg`}>
            <div class="tag">
              <div class="avatars" aria-hidden="true">
                {AVATARS[i].map((a) => <img src={`/avatars/${a}.webp`} width="64" height="64" alt="" loading="lazy" decoding="async" />)}
              </div>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</div>

<section class="section" id="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="privacy-panel">
      <p class="kicker">{s.privacy.eyebrow}</p>
      <h2 id="privacy-title">{s.privacy.title[0]} <span>{s.privacy.title[1]}</span></h2>
      <p>{s.privacy.body}</p>
      <div class="privacy-grid">
        {s.privacy.items.map((item) => (
          <div class="privacy-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<div class="wash wash-mirror">
  <section class="section" id="pro" aria-labelledby="plans-title">
    <div class="container">
      <div class="section-head center">
        <h2 id="plans-title">{s.plans.title}</h2>
        <p>{s.plans.body}</p>
      </div>
      <div class="plans">
        <article class="plan glass c-lime">
          <h3>{s.plans.free.name}</h3>
          <p class="tagline">{s.plans.free.tagline}</p>
          <ul class="checks">{s.plans.free.items.map((i) => <li>{i}</li>)}</ul>
        </article>
        <article class="plan plan-pro glass c-blue">
          <h3 class="pro-badge"><img src="/art/pro.webp" width="34" height="34" alt="" loading="lazy" />{s.plans.pro.name}</h3>
          <p class="tagline">{s.plans.pro.tagline}</p>
          <ul class="checks">{s.plans.pro.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      </div>
      <p class="plans-note">{s.plans.note}</p>
    </div>
  </section>

  <section class="section tight" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <!-- The title held beside the questions as they scroll by; each question its own
           glass card. -->
      <div class="faq-layout">
        <div class="faq-side">
          <p class="kicker">{s.faq.eyebrow}</p>
          <h2 id="faq-title">{s.faq.title}</h2>
          <div class="rule" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <p>{s.faq.body}</p>
          <div class="faq-ask">
            <img src="/icons/coin-96.webp" width="44" height="44" alt="" loading="lazy" />
            <p>{s.faq.ask[0]} <a href="mailto:nomadbudget@rubeeks.co">{s.faq.ask[1]} →</a></p>
          </div>
        </div>
        <div class="faq">
          {s.faq.items.map((item, i) => (
            <details class="glass" open={i === 0}>
              <summary><span class="faq-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="faq-q">{item.q}</span></summary>
              <div class="faq-a"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

{latest.length > 0 && (
  <section class="section tight latest" id="blog" aria-labelledby="latest-title">
    <div class="container">
      <div class="latest-head">
        <div class="section-head">
          <p class="kicker">{s.nav.blog}</p>
          <h2 id="latest-title">{s.blog.latest}</h2>
          <p>{s.blog.lede}</p>
        </div>
        <a class="latest-all" href={blogPath(lang)}>{s.blog.all} →</a>
      </div>
      <ul class="post-grid">
        {latest.map((p) => <li><PostCard post={p} level={3} /></li>)}
      </ul>
    </div>
  </section>
)}

<!-- The closing call as a boarding pass, lying on a few used ones, with the countries'
     polaroids and some of the app's coins on the table beside it. -->
<section class="container" aria-labelledby="final-title">
  <div class="final">
    <div class="pass-stack">
    <!-- The used passes under it, a neat pile showing only at the foot. -->
    <div class="pass-sheet pass-old" aria-hidden="true"><div class="pass"></div></div>
    <div class="pass-sheet pass-old" aria-hidden="true"><div class="pass"></div></div>
    <div class="pass-sheet pass-old" aria-hidden="true"><div class="pass"></div></div>
    <div class="pass-sheet pass-now" data-close={s.final.pass.close}><div class="pass">
      <div class="pass-head">
        <span class="pass-brand"><img src="/icons/coin-96.webp" width="26" height="26" alt="" loading="lazy" />Nomad Budget</span>
        <span>{s.final.pass.kicker}</span>
      </div>
      <div class="pass-main">
        <div class="pass-route" aria-hidden="true">
          <div><span>{s.final.pass.from}</span><b>{PASS_CODES[0]}</b><small>{s.final.pass.fromNote}</small></div>
          <div class="pass-line"><img src="/transport/flight.webp" width="256" height="256" alt="" loading="lazy" /></div>
          <div class="pass-to"><span>{s.final.pass.to}</span><b>{PASS_CODES[1]}</b><small>{s.final.pass.toNote}</small></div>
        </div>
        <h2 id="final-title">{s.final.title}</h2>
        <p>{s.final.body}</p>
        <dl class="pass-fields">
          {s.final.pass.fields.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      <div class="pass-stub">
        <dl class="pass-fields">
          <div><dt>{s.final.pass.gate[0]}</dt><dd>{s.final.pass.gate[1]}</dd></div>
        </dl>
        <a class="btn btn-lime" href={store} rel="noopener">{s.nav.download}</a>
        <!-- Where the corner's App Store code lands while the pass is on screen (the script below). -->
        <span class="pass-qr-slot" aria-hidden="true"></span>
      </div>
    </div></div>
    <div class="pass-table" aria-hidden="true">
      <img class="pass-coin" src="/icons/coin-96.webp" width="96" height="96" alt="" loading="lazy" />
      <img class="pass-coin" src="/icons/coin-96.webp" width="96" height="96" alt="" loading="lazy" />
      <img class="pass-coin" src="/icons/coin-96.webp" width="96" height="96" alt="" loading="lazy" />
      {TABLE.map((c) => (
        <figure class="strip-tile">
          <img src={c.src} width="480" height="360" alt="" loading="lazy" decoding="async" />
          <figcaption>
            <span class="strip-flag" set:html={c.flag} />
            <span class="strip-name">{c.name[lang]}</span>
            <span class="strip-currency">{c.currency}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    </div>
  </div>
</section>

<script>
  // The strip drifts only while it is on screen: under the card's frosted glass every
  // step of it is blurred again, work the page should not pay for further down.
  const strip = document.querySelector<HTMLElement>('.strip');
  if (strip) {
    new IntersectionObserver(([entry]) => strip.classList.toggle('is-idle', !entry.isIntersecting)).observe(strip);
  }
</script>

<script>
  // The FAQ's answers slide open and shut instead of jumping, and one open at a time:
  // opening a question closes the one that was open. <details> keeps doing the work
  // (keyboard, find-in-page, no-JS): the script only animates the answer's height around
  // the toggle — opening sets `open` first and grows into it, closing shrinks first and
  // clears `open` at the end. Reduced motion keeps the plain toggle.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const cards: { details: HTMLDetailsElement; slide: (opening: boolean) => void }[] = [];
  /** Closes every question but this one (one already closing is left to finish). */
  const closeOthers = (open: HTMLDetailsElement) => {
    for (const card of cards) {
      if (card.details === open || !card.details.open || card.details.classList.contains('is-closing')) continue;
      if (reduce.matches) card.details.open = false;
      else card.slide(false);
    }
  };
  for (const details of document.querySelectorAll<HTMLDetailsElement>('.faq details')) {
    const summary = details.querySelector('summary');
    const answer = details.querySelector<HTMLElement>('.faq-a');
    if (!summary || !answer) continue;
    let running: Animation | null = null;
    const slide = (opening: boolean) => {
      const from = running ? answer.offsetHeight : opening ? 0 : answer.offsetHeight;
      running?.cancel();
      details.classList.toggle('is-closing', !opening);
      if (opening) details.open = true;
      const to = opening ? answer.scrollHeight : 0;
      running = answer.animate(
        [{ height: `${from}px`, opacity: opening ? 0 : 1 }, { height: `${to}px`, opacity: opening ? 1 : 0 }],
        { duration: 320, easing: 'cubic-bezier(.2, .7, .2, 1)' },
      );
      // The promise, not the `finish` event: the event waits for the next rendered frame,
      // the promise settles as soon as the animation ends. A cancelled run (clicked again
      // mid-way) rejects, and the run that replaced it takes over.
      const run = running;
      run.finished.then(
        () => {
          if (running !== run) return;
          if (!opening) details.open = false;
          details.classList.remove('is-closing');
          running = null;
        },
        () => {},
      );
    };
    cards.push({ details, slide });
    summary.addEventListener('click', (e) => {
      if (reduce.matches) return;
      e.preventDefault();
      const opening = !details.open || details.classList.contains('is-closing');
      slide(opening);
      if (opening) closeOthers(details);
    });
    // However it opened — a click with reduced motion, find-in-page — the others close.
    details.addEventListener('toggle', () => { if (details.open) closeOthers(details); });
  }
</script>

<script>
  // The corner's App Store code boards the pass. While the pass is on screen the card
  // flies from its corner into the slot on the stub and becomes part of the pass (it
  // tilts and lifts with it); once the pass has gone by, it flies back to its corner.
  // The flight is drawn frame by frame towards wherever the slot is now, so a reader who
  // keeps scrolling meanwhile is still met in the right place. Only where the corner card
  // shows (computers); with reduced motion it simply moves.
  const qr = document.querySelector<HTMLElement>('.qr-float');
  const slot = document.querySelector<HTMLElement>('.pass-qr-slot');
  const pass = document.querySelector<HTMLElement>('.pass-now');
  if (qr && slot && pass) {
    const home = qr.parentElement!;
    const homeNext = qr.nextSibling;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    /** The pass's own tilt at rest, which the card takes on as it lands. */
    const TILT = -1.5;
    const DURATION = 650;
    /** Where the card is drawn, as an offset from its corner. */
    let at = { x: 0, y: 0, r: 0 };
    let frame = 0;
    let want: 'home' | 'pass' = 'home';

    const shows = () => getComputedStyle(slot).display !== 'none';
    const centre = (r: DOMRect) => ({ x: r.left + r.width / 2, y: r.top + r.height / 2 });
    /** The card's corner centre, measured with it at home and untransformed. */
    const corner = () => {
      const t = qr.style.transform;
      qr.style.transform = 'none';
      const c = centre(qr.getBoundingClientRect());
      qr.style.transform = t;
      return c;
    };
    const draw = () => { qr.style.transform = `translate(${at.x}px, ${at.y}px) rotate(${at.r}deg)`; };
    /** The card's two shadows, in its corner (as .qr-float) and stuck on the pass (as
     *  .qr-float.is-docked): [y, blur, r, g, b, alpha] for the near one, then the far one. */
    const SHADOW_HOME = [[1, 2, 12, 24, 36, .08], [14, 36, 4, 8, 18, .28]];
    const SHADOW_PASS = [[1, 1, 40, 32, 20, .14], [3, 6, 40, 32, 20, .08]];
    /** The shadow part-way between the two (k: 0 in the corner, 1 on the pass), spread a
     *  little wider while the card is up in the air (lift: 0 to 1). */
    const shade = (k: number, lift: number) => SHADOW_HOME.map((from, i) => {
      const [y, blur, r, g, b, a] = from.map((v, j) => v + (SHADOW_PASS[i][j] - v) * k);
      const up = i === 1 ? lift : 0;
      return `0 ${(y + 12 * up).toFixed(1)}px ${(blur + 18 * up).toFixed(1)}px rgba(${r | 0}, ${g | 0}, ${b | 0}, ${(a - .06 * up).toFixed(3)})`;
    }).join(', ');
    const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

    const toHome = () => {
      if (qr.parentElement !== home) home.insertBefore(qr, homeNext);
      qr.classList.remove('is-docked');
      qr.classList.add('is-flying');
    };
    const dock = () => {
      cancelAnimationFrame(frame);
      qr.classList.remove('is-flying');
      qr.classList.add('is-docked');
      qr.style.transform = '';
      qr.style.boxShadow = '';
      slot.append(qr);
      at = { x: 0, y: 0, r: 0 };
    };
    const rest = () => {
      cancelAnimationFrame(frame);
      qr.classList.remove('is-flying');
      qr.style.transform = '';
      qr.style.boxShadow = '';
      at = { x: 0, y: 0, r: 0 };
    };

    /** Flies the card from where it is drawn now to the slot (wherever the slot has got
     *  to by each frame) or back to its corner. */
    const fly = (to: 'home' | 'pass') => {
      cancelAnimationFrame(frame);
      // Leaving the pass: back in the corner's layer, drawn exactly where it sat.
      if (qr.parentElement === slot) {
        const from = centre(qr.getBoundingClientRect());
        toHome();
        const c = corner();
        at = { x: from.x - c.x, y: from.y - c.y, r: TILT };
        draw();
      } else {
        toHome();
      }
      if (still.matches) return to === 'pass' ? dock() : rest();
      const start = { ...at };
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / DURATION);
        const e = ease(t);
        let end = { x: 0, y: 0, r: 0 };
        if (to === 'pass') {
          const c = corner();
          const s = centre(slot.getBoundingClientRect());
          end = { x: s.x - c.x, y: s.y - c.y, r: TILT };
        }
        // A little arc on the way, as a card tossed rather than slid.
        const arc = Math.sin(Math.PI * t);
        at = { x: start.x + (end.x - start.x) * e, y: start.y + (end.y - start.y) * e - 36 * arc, r: start.r + (end.r - start.r) * e };
        draw();
        // The shadow follows the card down a beat behind it: it is still settling as the
        // card touches the paper, and only reaches the pass's own at the very end. Going
        // home it lifts off the paper first.
        const k = to === 'pass' ? t * t * (3 - 2 * t) * t : 1 - Math.sqrt(t);
        qr.style.boxShadow = shade(Math.max(0, Math.min(1, k)), arc);
        if (t < 1) frame = requestAnimationFrame(step);
        else if (to === 'pass') dock();
        else rest();
      };
      frame = requestAnimationFrame(step);
    };

    const update = (ratio: number) => {
      if (!shows()) {
        if (qr.parentElement === slot || want === 'pass') { want = 'home'; toHome(); rest(); }
        return;
      }
      const next = ratio >= .6 ? 'pass' : ratio <= .25 ? 'home' : want;
      if (next !== want) { want = next; fly(next); }
    };
    // The slot keeps the card's own height, so nothing on the stub moves when it lands.
    slot.style.setProperty('--qr-h', `${qr.offsetHeight || 128}px`);
    new IntersectionObserver(([entry]) => update(entry.intersectionRatio), { threshold: [0, .25, .6, 1] }).observe(pass);
    addEventListener('resize', () => update(want === 'pass' ? 1 : 0));
  }
</script>

<script>
  // A click anywhere on the pass but its links tears the stub off along the perforation
  // and brings it to the middle of the screen, over the page frosted as the header frosts
  // it. The torn piece is a copy of the whole pass laid exactly over it, cut down to the
  // stub, while the pass itself is cut down to the rest; the copy rips a little way off,
  // then flies to the centre and grows. A click outside it, Escape or its close button
  // sends it back to its place and the pass is whole again. With reduced motion it simply
  // appears and goes.
  const sheet = document.querySelector<HTMLElement>('.pass-now');
  const pass = sheet?.querySelector<HTMLElement>('.pass');
  const stub = pass?.querySelector<HTMLElement>('.pass-stub');
  if (sheet && pass && stub) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const EASE = 'cubic-bezier(.2, .7, .2, 1)';
    let layer: HTMLElement | null = null;
    let busy = false;
    let returnFocus: HTMLElement | null = null;

    /** Where the pass lies on screen: its untilted box, the torn piece in it (the stub, with
     *  the end of the band over it on a wide pass) and that piece's centre, and the turn
     *  and shift the sheet gives that centre now (the sheet turns about its middle). */
    const measure = () => {
      const transform = getComputedStyle(sheet).transform;
      sheet.style.transition = 'none';
      sheet.style.transform = 'none';
      const box = pass.getBoundingClientRect();
      sheet.style.transform = '';
      void sheet.offsetWidth;
      sheet.style.transition = '';
      const m = new DOMMatrix(transform === 'none' ? undefined : transform);
      // The tear runs down the side of the stub on a wide pass, across its top on a phone.
      const side = stub.offsetLeft > 0;
      const cut = side ? stub.offsetLeft : stub.offsetTop;
      const w = side ? box.width - cut : box.width;
      const h = side ? box.height : box.height - cut;
      const cx = side ? cut + w / 2 : w / 2;
      const cy = side ? h / 2 : cut + h / 2;
      const at = m.transformPoint(new DOMPoint(cx - box.width / 2, cy - box.height / 2));
      return {
        box, side, cut, w, h, cx, cy,
        angle: (Math.atan2(m.b, m.a) * 180) / Math.PI,
        dx: at.x + box.width / 2 - cx,
        dy: at.y + box.height / 2 - cy,
      };
    };
    type Lie = ReturnType<typeof measure>;
    /** The piece's transform, about the stub's centre: where the pass has it, then moved. */
    const place = (g: Lie, x: number, y: number, r: number, s = 1) =>
      `translate(${g.dx + x}px, ${g.dy + y}px) rotate(${r}deg) scale(${s})`;

    const open = () => {
      if (layer || busy) return;
      busy = true;
      returnFocus = document.activeElement as HTMLElement | null;
      const g = measure();
      const cut = g.cut;

      layer = document.createElement('div');
      layer.className = 'pass-tear';
      layer.setAttribute('role', 'dialog');
      layer.setAttribute('aria-modal', 'true');
      layer.setAttribute('aria-label', stub.querySelector('a')?.textContent ?? '');
      const backdrop = document.createElement('div');
      backdrop.className = 'pass-tear-backdrop';
      const piece = document.createElement('div');
      piece.className = 'pass-sheet pass-tear-piece';
      const copy = pass.cloneNode(true) as HTMLElement;
      copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      copy.querySelector('.pass-main')?.setAttribute('inert', '');
      copy.querySelector('.pass-head')?.setAttribute('aria-hidden', 'true');
      // The App Store code goes with the stub, at rest in its slot whatever it was doing.
      const slot = copy.querySelector<HTMLElement>('.pass-qr-slot');
      const qr = document.querySelector<HTMLElement>('.qr-float');
      if (slot && qr && getComputedStyle(stub.querySelector('.pass-qr-slot')!).display !== 'none') {
        const card = qr.cloneNode(true) as HTMLElement;
        card.classList.remove('is-flying');
        card.classList.add('is-docked');
        card.style.transform = '';
        card.style.boxShadow = '';
        slot.replaceChildren(card);
      }
      copy.style.clipPath = g.side ? `inset(0 0 0 ${cut}px)` : `inset(${cut}px 0 0 0)`;
      // The pass's own size: away from the section some of its spacing goes, and the copy
      // would come out shorter than the pass it is torn from.
      copy.style.width = `${g.box.width}px`;
      copy.style.height = `${g.box.height}px`;
      piece.append(copy);
      Object.assign(piece.style, {
        left: `${g.box.left}px`, top: `${g.box.top}px`, width: `${g.box.width}px`, height: `${g.box.height}px`,
        transformOrigin: `${g.cx}px ${g.cy}px`, transform: place(g, 0, 0, g.angle),
      });
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'pass-tear-close';
      close.setAttribute('aria-label', sheet.dataset.close ?? 'Close');
      layer.append(backdrop, piece, close);
      document.body.append(layer);
      pass.style.clipPath = g.side ? `inset(0 ${g.box.width - cut}px 0 0)` : `inset(0 0 ${g.box.height - cut}px 0)`;

      // To the middle of the screen, as large as fits (up to half as large again).
      const scale = Math.min(1.5, (innerHeight * .82) / g.h, (innerWidth * .9) / g.w);
      const toX = innerWidth / 2 - (g.box.left + g.cx) - g.dx;
      const toY = innerHeight / 2 - (g.box.top + g.cy) - g.dy;
      // First it rips away from the tear: out to the side, or down off a phone's pass.
      const rip = g.side ? [22, -6, g.angle + 5] : [0, 20, g.angle + 3];
      const settled = place(g, toX, toY, 0, scale);
      const done = () => {
        busy = false;
        // Focus on the button, for the keyboard, without the ring a pointer has no need of
        // (the pass opens only to a click or a tap).
        piece.querySelector<HTMLElement>('.pass-stub a')?.focus({ preventScroll: true, focusVisible: false } as FocusOptions);
      };
      if (still.matches) {
        piece.style.transform = settled;
        done();
      } else {
        backdrop.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 520, easing: 'ease' });
        close.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 480, fill: 'backwards' });
        piece.style.transform = settled;
        piece.animate(
          [
            { transform: place(g, 0, 0, g.angle) },
            { transform: place(g, rip[0], rip[1], rip[2]), offset: .32, easing: EASE },
            { transform: settled },
          ],
          { duration: 820, easing: 'cubic-bezier(.3, .6, .3, 1)' },
        ).finished.then(done, done);
      }

      backdrop.addEventListener('click', () => shut());
      close.addEventListener('click', () => shut());
      // The page stays put under it.
      const hold = (e: Event) => e.preventDefault();
      layer.addEventListener('wheel', hold, { passive: false });
      layer.addEventListener('touchmove', hold, { passive: false });
    };

    /** Puts the stub back on the pass; `now` skips the flight (the window was resized). */
    const shut = (now = false) => {
      if (!layer || (busy && !now)) return;
      busy = true;
      const current = layer;
      const finish = () => {
        pass.style.clipPath = '';
        current.remove();
        layer = null;
        busy = false;
        returnFocus?.focus({ preventScroll: true });
      };
      if (now || still.matches) return finish();
      const piece = current.querySelector<HTMLElement>('.pass-tear-piece')!;
      const g = measure();
      current.classList.add('is-closing');
      current.querySelector('.pass-tear-backdrop')!.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 480, easing: 'ease', fill: 'forwards' });
      piece.animate([{ transform: piece.style.transform }, { transform: place(g, 0, 0, g.angle) }], { duration: 560, easing: EASE, fill: 'forwards' })
        .finished.then(finish, finish);
    };

    sheet.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      open();
    });
    addEventListener('keydown', (e) => {
      if (!layer) return;
      if (e.key === 'Escape') shut();
      // Focus stays in the torn stub while it is out: its links and the close button.
      if (e.key === 'Tab') {
        const stops = [...layer.querySelectorAll<HTMLElement>('.pass-stub a, .pass-tear-close')];
        const i = stops.indexOf(document.activeElement as HTMLElement);
        stops[(i + (e.shiftKey ? -1 : 1) + stops.length) % stops.length]?.focus();
        e.preventDefault();
      }
    });
    addEventListener('resize', () => shut(true));
  }
</script>

<script>
  // The features' trip. The middle of the screen is where the reader is; the vehicle
  // follows it down the line between the stops but lingers at each one and hurries
  // between them, so it pulls in beside a feature while that feature is being read.
  // It turns round when the reader scrolls back up, a clear way back rather than the
  // wheel's own little bounces, and turns as a car does, mirrored in place, not spun on
  // its nose; it never goes faster than a steady pace, so a quick flick up does not send
  // it racing back past the stops. Every time it pulls into a stop, going either way, it
  // turns into that stop's vehicle. Only where the two columns stand side by side (the CSS hides the
  // route elsewhere). With reduced motion there is no vehicle: the line is drawn whole.
  const features = document.querySelector<HTMLElement>('.features');
  const route = features?.querySelector<HTMLElement>('.route');
  const vehicle = route?.querySelector<HTMLElement>('.route-vehicle');
  const fill = route?.querySelector<HTMLElement>('.route-fill');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (features && route && vehicle && fill) {
    const articles = [...features.querySelectorAll<HTMLElement>('.feature')];
    const kinds = (route.dataset.vehicles ?? '').split(' ');
    const sprites = new Map([...vehicle.querySelectorAll<HTMLImageElement>('img')].map((img) => [img.dataset.vehicle!, img]));
    const wide = matchMedia('(min-width: 821px)');
    /** Each stop's height down the route, the first at 0. */
    let stops: number[] = [];
    /** The first stop's height inside the features block. */
    let first = 0;
    let y = 0;
    /** Which way it faces: 1 down the route, -1 back up it; and the mirror it is drawn
     *  with now, easing from one to the other as it turns. */
    let facing = 1;
    let mirror = 1;
    /** How far back the reader must go before it turns round (px). */
    const TURN = 14;
    /** Its top speed, px per ms. */
    const PACE = 1.4;
    /** The stop whose vehicle is showing. */
    let shown = -1;
    let last = 0;
    let frame = 0;
    let visible = false;

    const measure = () => {
      const centres = articles.map((a) => a.offsetTop + a.offsetHeight / 2);
      stops = centres.map((c) => c - centres[0]);
      first = centres[0];
      const length = stops[stops.length - 1] || 1;
      route.style.top = `${centres[0]}px`;
      route.style.height = `${length}px`;
      // The travelled line takes each feature's colour as it passes it.
      fill.style.backgroundImage = `linear-gradient(180deg, ${articles
        .map((a, i) => `var(--acc-${a.dataset.accent}) ${((stops[i] / length) * 100).toFixed(2)}%`)
        .join(', ')})`;
    };

    /** How far down the route the vehicle should be for this scroll. */
    const target = () => {
      // Read live: anything above that grows or shrinks (a font arriving) moves the block
      // without resizing it, which the ResizeObserver would never hear about.
      const focus = innerHeight / 2 - features.getBoundingClientRect().top - first;
      const n = stops.length - 1;
      if (focus <= 0) return 0;
      if (focus >= stops[n]) return stops[n];
      let i = 0;
      while (i < n - 1 && focus >= stops[i + 1]) i++;
      const t = (focus - stops[i]) / (stops[i + 1] - stops[i]);
      // A quarter of each leg's scroll is spent standing at either end of it.
      const u = Math.min(1, Math.max(0, (t - 0.25) / 0.5));
      const eased = u * u * (3 - 2 * u);
      return stops[i] + eased * (stops[i + 1] - stops[i]);
    };

    const draw = (now: number) => {
      frame = 0;
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      const gap = target() - y;
      const from = y;
      // A little weight behind it: it eases after the reader rather than jumping with
      // every notch of the wheel.
      const step = gap * (1 - Math.exp(-dt / 110));
      y += Math.max(-PACE * dt, Math.min(PACE * dt, step));
      if (gap > TURN) facing = 1;
      else if (gap < -TURN) facing = -1;
      mirror += (facing - mirror) * (1 - Math.exp(-dt / 120));
      // The vehicle changes as it pulls in, not when the reader passes the stop: the
      // last stop it reached this frame — one it is sitting at, or one a fast scroll
      // carried it over — or on the first frame the nearest one.
      const lo = Math.min(from, y) - 3;
      const hi = Math.max(from, y) + 3;
      let at = -1;
      stops.forEach((s, i) => {
        if (s >= lo && s <= hi && (at < 0 || Math.abs(s - y) < Math.abs(stops[at] - y))) at = i;
      });
      if (at < 0 && shown < 0) at = nearest();
      if (at >= 0 && at !== shown) {
        shown = at;
        const name = kinds[at % kinds.length];
        for (const [key, img] of sprites) img.classList.toggle('is-on', key === name);
      }
      vehicle.style.transform = `translate3d(-50%, calc(${y.toFixed(1)}px - 50%), 0) rotate(90deg) scaleX(${mirror.toFixed(3)})`;
      fill.style.clipPath = `inset(0 0 ${Math.max(0, stops[stops.length - 1] - y).toFixed(1)}px 0)`;
      articles.forEach((a, i) => a.classList.toggle('is-reached', y >= stops[i] - 2));
      vehicle.classList.toggle('is-tappable', next() >= 0);
      const settled = Math.abs(gap) < 0.3 && Math.abs(facing - mirror) < 0.005;
      if (!settled && visible) frame = requestAnimationFrame(draw);
      else last = 0;
    };
    const wake = () => {
      if (!frame && visible && !still && wide.matches) frame = requestAnimationFrame(draw);
    };
    const nearest = () => stops.reduce((best, s, i) => (Math.abs(s - y) < Math.abs(stops[best] - y) ? i : best), 0);
    /** The stop ahead of the vehicle, or -1 once it has pulled into the last one. */
    const next = () => stops.findIndex((s) => s > y + 4);

    // A tap on the vehicle brings the next stop to the middle of the screen, where the
    // vehicle pulls in: the page scrolls, and the vehicle rides along with it.
    vehicle.addEventListener('click', () => {
      const k = next();
      if (k < 0) return;
      const at = scrollY + features.getBoundingClientRect().top + first + stops[k] - innerHeight / 2;
      scrollTo({ top: at, behavior: 'smooth' });
    });

    measure();
    y = target();
    features.classList.add(still ? 'has-route' : 'has-trip');
    new ResizeObserver(() => { measure(); wake(); }).observe(features);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      wake();
    }, { rootMargin: '25% 0px' }).observe(features);
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', wake);
  }
</script>
